          "name": "Create an Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Convert response to JSON\r\nlet response = pm.response.json();\r\n\r\n// Save accountId as a Collection Variable\r\npm.collectionVariables.set(\"accountId\", response.accountId);\r\n\r\n// Verify accountId exists\r\npm.test(\"Account ID was generated\", function () {\r\n    pm.expect(response.accountId).to.exist;\r\n    pm.expect(response.accountId).to.not.be.empty;\r\n});\r\n\r\n// Log it to Postman Console\r\nconsole.log(\"Saved Account ID:\", response.accountId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"accountName\": \"{{accountName}}\",\r\n  \"accountType\": \"{{accountType}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
